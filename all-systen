local PlaceId = game.PlaceId
local JobId = game.JobId

local Scripts = {
    [142823291] = "https://raw.githubusercontent.com/yourname/yourrepo/main/mm2.lua",
}

local FallbackScript = "https://raw.githubusercontent.com/yourname/yourrepo/main/universal.lua"

local function LoadScript(url, mode)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if success then
        print("[Universal] โหลดสคริปต์สำเร็จ (".. mode.. ") | PlaceId: ".. PlaceId)
    else
        warn("[Universal] โหลดสคริปต์ล้มเหลว:", err)
    end
end

if Scripts[PlaceId] then
    LoadScript(Scripts[PlaceId], "specific")
else
    print("[Universal] ไม่พบเกมนี้ในระบบ (PlaceId: ".. PlaceId.. ") กำลังโหลดสคริปต์กลาง...")
    LoadScript(FallbackScript, "fallback")
end
